{
  "name": "quanta-studio",
  "productName": "Quanta Studio",
  "version": "1.0.0",
  "description": "Scientific graphing, biostatistics and numerical computing in one desktop app, with Claude built in.",
  "author": "Quanta Studio contributors",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "homepage": "https://github.com/KakiroX/Winners2",
  "scripts": {
    "dev": "concurrently -k -n web,main,app \"vite\" \"node scripts/build-electron.mjs --watch\" \"wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && npm run build:web && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.17",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "immer": "^11.2.9",
    "lucide-react": "^1.66.0",
    "marked": "^18.1.2",
    "ml-matrix": "^6.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "desktopName": "quanta-studio.desktop"
}
